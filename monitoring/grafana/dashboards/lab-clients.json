  {
   "type": "timeseries",
   "title": "Processed per member (msg/s)",
   "description": "",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "lineInterpolation": "linear",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (instance) (rate(lab_consumer_processedtotal[30s]))",
     "legendFormat": "{{instance}}",
     "refId": "A",
