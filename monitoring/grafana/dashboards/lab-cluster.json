  },
  {
   "type": "timeseries",
   "title": "Bytes in by broker",
   "description": "",
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "lineInterpolation": "linear",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (instance) (rate(kafka_server_brokertopicmetrics_bytesin_total{topic!=\"\"}[30s]))",
     "legendFormat": "{{instance}}",
     "refId": "A",
     "interval": "5s"
    }
   ],
   "id": 3,
